# --- repository-wide ---
.tmp/
*.log
.DS_Store

# --- build outputs, wherever they appear ---
# Covers android/*/build/, ios/build/ (the path ios/README.md's recipe uses) and any nested
# Gradle, Xcode or SwiftPM output. A bare pattern without a leading slash matches at every level.
build/
.build/
out/
DerivedData/
.swiftpm/
xcuserdata/

# --- Android / Gradle ---
android/local.properties
android/.gradle/
android/.kotlin/
.kotlin/
android/captures/
.idea/
*.iml
*.hprof

# --- iOS / Xcode ---
# The .xcodeproj is generated from project.yml by XcodeGen and must never be committed.
ios/*.xcodeproj/
ios/*.xcworkspace/
*.ipa
*.dSYM.zip

# --- packaging / signing (never commit these) ---
*.apk
*.aab
*.keystore
*.jks
*.p12
*.mobileprovision

# --- tooling ---
__pycache__/
*.pyc
